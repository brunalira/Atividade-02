<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo"
            android:textSize="18sp"
            android:textColor="@color/texto"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cbArroz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/produto_arroz" />

        <CheckBox
            android:id="@+id/cbLeite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/produto_leite" />

        <CheckBox
            android:id="@+id/cbCarne"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/produto_carne" />

        <CheckBox
            android:id="@+id/cbFeijao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/produto_feijao" />

        <CheckBox
            android:id="@+id/cbCoca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/produto_coca" />

        <Button
            android:id="@+id/btnCalcular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_calcular"
            android:backgroundTint="@color/verde_botao"
            android:textColor="@color/branco"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resultado_total"
            android:textSize="18sp"
            android:textColor="@color/texto"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
